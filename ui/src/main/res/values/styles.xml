<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomAppBar" parent="Widget.MaterialComponents.BottomAppBar.PrimarySurface">
        <item name="android:layout_gravity">bottom</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="fabCradleRoundedCornerRadius">10dp</item>
        <item name="fabAlignmentMode">center</item>
    </style>

    <style name="BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:layout_gravity">bottom</item>
        <item name="elevation">2dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="background">@color/colorTransparent</item>
        <item name="backgroundTint">@color/colorTransparent</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationViewItem.Active</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationViewItem</item>
    </style>

    <style name="FabBottomNavigation" parent="Widget.Design.FloatingActionButton">
        <item name="elevation">4dp</item>
        <item name="backgroundTint">@color/primary500</item>
        <item name="fabCustomSize">55dp</item>
        <item name="maxImageSize">24dp</item>
    </style>

    <style name="BottomNavigationViewItem" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:textAppearance">@style/Typography.Button_Regular</item>
        <item name="itemIconSize">14dp</item>
        <item name="itemTextColor">@color/primary200</item>
    </style>

    <style name="BottomNavigationViewItem.Active">
        <item name="android:textAppearance">@style/Typography.Button_Bold</item>
        <item name="itemIconSize">18dp</item>
        <item name="itemTextColor">@color/primary200</item>
    </style>

    <style name="Theme.TextInputEditText.Light" parent="">
        <item name="colorControlActivated">@color/white</item>
    </style>

    <style name="Theme.TextInputEditText.Dark" parent="">
        <item name="colorControlActivated">@color/primary500</item>
    </style>

    <style name="TextInputEditText">
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_border_text_input</item>
        <item name="drawableTint">@color/primary50</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:textColorHint">@color/primary100</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/Typography.Body1_SemiBold</item>
        <item name="hintTextAppearance">@style/Typography.Body1_SemiBold</item>
    </style>

    <style name="TextInputEditText.White">
        <item name="android:background">@drawable/bg_text_input_edit_text_white</item>
        <item name="drawableTint">@color/neutral200</item>
        <item name="android:textColorHint">@color/neutral50</item>
        <item name="android:textColor">@color/neutral200</item>
    </style>

    <style name="TextInputLayout.Light" parent="Widget.Design.TextInputLayout">
        <item name="android:background">@color/colorTransparent</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/error500</item>
        <item name="android:theme">@style/Theme.TextInputEditText.Light</item>
    </style>

    <style name="TextInputLayout.Dark" parent="Widget.Design.TextInputLayout">
        <item name="android:background">@color/colorTransparent</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/error500</item>
        <item name="android:theme">@style/Theme.TextInputEditText.Dark</item>
    </style>

    <style name="ButtonPrimaryDarker" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/selector_button_primary_darker</item>
        <item name="android:textColor">@color/color_control_text_button</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAppearance">@style/Typography.Button_Bold</item>
        <item name="lineHeight">24dp</item>
    </style>

    <style name="ButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/selector_button_primary</item>
        <item name="android:textColor">@color/color_control_text_button</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAppearance">@style/Typography.Button_Bold</item>
        <item name="lineHeight">24dp</item>
    </style>

    <style name="ButtonPrimaryLighter" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/selector_button_primary_lighter</item>
        <item name="android:textColor">@color/color_control_text_button_lighter</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAppearance">@style/Typography.Button_Bold</item>
        <item name="lineHeight">24dp</item>
    </style>

    <style name="ButtonWhiteBordered" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/selector_button_white_bordered</item>
        <item name="android:textColor">@color/color_control_text_button_white</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAppearance">@style/Typography.Button_Bold</item>
        <item name="lineHeight">24dp</item>
    </style>

    <style name="ButtonTransparentBordered" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/selector_button_transparent_bordered</item>
        <item name="android:textColor">@color/color_control_text_button</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAppearance">@style/Typography.Button_Bold</item>
        <item name="lineHeight">24dp</item>
    </style>

    <style name="ButtonTransparentBordered.Darker">
        <item name="android:background">@drawable/selector_button_transparent_bordered_darker</item>
        <item name="android:textColor">@color/neutral400</item>
    </style>

    <style name="BottomSheetModal" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <style name="BottomSheetModalWithDimming" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModal</item>
    </style>

    <style name="BottomSheetStyleWithDimming" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalWithDimming</item>
    </style>
</resources>