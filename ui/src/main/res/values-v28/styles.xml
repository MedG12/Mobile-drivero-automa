<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:layout_gravity">bottom</item>
        <item name="elevation">5dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="background">@color/colorTransparent</item>
        <item name="backgroundTint">@color/colorTransparent</item>
        <item name="android:outlineSpotShadowColor">@color/colorTransparent</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationViewItem.Active</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationViewItem</item>
    </style>

    <style name="FabBottomNavigation" parent="Widget.Design.FloatingActionButton">
        <item name="elevation">10dp</item>
        <item name="backgroundTint">@color/primary500</item>
        <item name="android:outlineSpotShadowColor">@color/colorTransparent</item>
        <item name="fabCustomSize">55dp</item>
        <item name="maxImageSize">24dp</item>
    </style>
</resources>