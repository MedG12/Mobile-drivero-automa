<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitleLiveMonitoringDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Typography.Body1_Bold"
        android:textColor="@color/neutral500"
        android:text="Fleet Detail"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glMiddle"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.6"
        android:orientation="vertical"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelFleetId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:text="@string/label_fleet_id"
        android:textColor="@color/neutral500"
        style="@style/Typography.Caption_Bold"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/glMiddle"
        app:layout_constraintTop_toBottomOf="@id/tvTitleLiveMonitoringDetail"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFleetId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tvLabelFleetId"
        app:layout_constraintStart_toStartOf="@id/tvLabelFleetId"
        app:layout_constraintEnd_toEndOf="@id/tvLabelFleetId"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelObd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/label_obd_code"
        android:textColor="@color/neutral500"
        style="@style/Typography.Caption_Bold"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/glMiddle"
        app:layout_constraintTop_toBottomOf="@id/tvFleetId"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvObd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tvLabelObd"
        app:layout_constraintStart_toStartOf="@id/tvLabelFleetId"
        app:layout_constraintEnd_toEndOf="@id/tvLabelFleetId"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelPosition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/label_position"
        android:textColor="@color/neutral500"
        style="@style/Typography.Caption_Bold"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/glMiddle"
        app:layout_constraintTop_toBottomOf="@id/tvObd"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPosition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tvLabelPosition"
        app:layout_constraintStart_toStartOf="@id/tvLabelFleetId"
        app:layout_constraintEnd_toEndOf="@id/tvLabelFleetId"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOpenMaps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/primary500"
        android:text="@string/label_click_to_open_map"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tvPosition"
        app:layout_constraintStart_toStartOf="@id/tvLabelFleetId"
        app:layout_constraintEnd_toEndOf="@id/tvLabelFleetId"/>

    <LinearLayout
        android:id="@+id/llChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="76dp"
        android:minHeight="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tvOpenMaps"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            style="@style/Typography.Caption_Regular"
            android:text="@string/label_task_progress_done"
            android:textColor="@color/success500"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_fleet_status"
        android:textColor="@color/neutral500"
        style="@style/Typography.Caption_Bold"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@id/glMiddle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvLabelFleetId"
        app:layout_constraintBottom_toBottomOf="@id/tvLabelFleetId"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toBottomOf="@id/tvLabelStatus"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelLastUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_last_updated"
        android:textColor="@color/neutral500"
        style="@style/Typography.Caption_Bold"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@id/glMiddle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLastUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@id/glMiddle"
        app:layout_constraintTop_toBottomOf="@id/tvLabelLastUpdated"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFuelLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        android:drawableStart="@drawable/ic_fuel"
        app:drawableTint="@color/primary500"
        android:drawablePadding="4dp"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toBottomOf="@id/tvLastUpdated"
        app:layout_constraintStart_toEndOf="@id/glMiddle"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        android:drawableStart="@drawable/ic_speed_24"
        app:drawableTint="@color/primary500"
        android:drawablePadding="4dp"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toBottomOf="@id/tvFuelLevel"
        app:layout_constraintStart_toEndOf="@id/glMiddle"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOdometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Typography.Caption_Regular"
        android:textColor="@color/neutral500"
        tools:text="Weekly Service"
        android:drawableStart="@drawable/ic_odometer"
        app:drawableTint="@color/primary500"
        android:drawablePadding="4dp"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toBottomOf="@id/tvSpeed"
        app:layout_constraintStart_toEndOf="@id/glMiddle"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>