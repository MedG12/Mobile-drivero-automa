<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:background="@drawable/bg_border_neutral300">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_do_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="2dp"
        style="@style/Typography.Subtitle2_Bold"
        android:textColor="@color/neutral500"
        tools:text="DO A1234.4444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivExpand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        app:srcCompat="@drawable/ic_baseline_keyboard_arrow_down_24"
        app:tint="@color/neutral500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_do_number"
        app:layout_constraintBottom_toBottomOf="@id/tv_do_number"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContentPod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tv_do_number">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="150dp"
            tools:minHeight="150dp"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="fitXY"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelPlateFleet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Typography.Body2_Regular"
            android:textColor="@color/neutral500"
            android:text="@string/label_fleet_plate"
            app:layout_constraintTop_toBottomOf="@id/ivPod"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFleetPlateNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            style="@style/Typography.Body2_Regular"
            android:textColor="@color/neutral600"
            tools:text="B 1234 EF"
            app:layout_constraintTop_toTopOf="@id/tvLabelPlateFleet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvLabelPlateFleet"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Typography.Body2_Regular"
            android:textColor="@color/neutral500"
            android:text="@string/label_description"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPlateFleet"
            app:layout_constraintStart_toStartOf="@id/tvLabelPlateFleet"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Typography.Body2_Regular"
            android:textColor="@color/neutral600"
            tools:text="Activity Name Lorem Ipsum Dolor"
            app:layout_constraintTop_toTopOf="@id/tvLabelDescription"
            app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelCreatedOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Typography.Body2_Regular"
            android:textColor="@color/neutral500"
            android:text="@string/label_time"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="@id/tvLabelPlateFleet"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCreatedOn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Typography.Body2_Regular"
            android:textColor="@color/neutral600"
            tools:text="2022-10-20 14:00:00"
            app:layout_constraintTop_toTopOf="@id/tvLabelCreatedOn"
            app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>