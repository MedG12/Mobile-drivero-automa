<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="4dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginVertical="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12.5dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCertificateName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Typography.Subtitle1_SemiBold"
            tools:text="DO.A.111.234.333"
            android:textColor="@color/primary500"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@id/tvCertificateName"
            app:layout_constraintBottom_toBottomOf="@id/tvCertificateName"
            app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout
                android:id="@+id/btnEditCertificate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_pencil_alt"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/btnDeleteCertificate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_trash"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/chipLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="13dp"
            android:background="@drawable/bg_chip_status"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvCertificateName"
            app:layout_constraintStart_toStartOf="@id/tvCertificateName">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                style="@style/Typography.Caption_Regular"
                android:text="@string/label_task_progress_done"
                android:textColor="@color/neutral500"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@id/chipLevel">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Activity Name Lorem Ipsum Dolor sit amet asdqweqwr"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelCertDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Tanggal sertifikat:"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="@id/tvDescription"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCertDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                style="@style/Typography.Body2_SemiBold"
                tools:text="2022-06-07"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelCertDate"
                app:layout_constraintStart_toEndOf="@id/tvLabelCertDate"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelExpDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Tanggal expiry:"
                android:textColor="@color/neutral500"
                app:layout_constraintStart_toStartOf="@id/tvLabelCertDate"
                app:layout_constraintTop_toBottomOf="@id/tvLabelCertDate"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvExpDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="2022-06-07"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelExpDate"
                app:layout_constraintStart_toStartOf="@id/tvCertDate"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>