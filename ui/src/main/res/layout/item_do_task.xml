<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12.5dp"
    android:background="@drawable/selector_bg_item_task">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDONumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        style="@style/Typography.Subtitle1_SemiBold"
        tools:text="DO.A.111.234.333"
        android:textColor="@color/primary500"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/llRightItemDoView"/>
    <LinearLayout
        android:id="@+id/llRightItemDoView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="@id/tvDONumber"
        app:layout_constraintBottom_toBottomOf="@id/tvDONumber"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/chipSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="76dp"
            android:minHeight="22dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_circle_check"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="@style/Typography.Caption_Regular"
                android:text="@string/label_task_progress_done"
                android:textColor="@color/success500"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvViewTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_view"
            android:textColor="@color/primary500"
            style="@style/Typography.Subtitle2_Regular" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvDONumber">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelPlateFleet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Typography.Body2_SemiBold"
            android:text="@string/label_fleet_plate"
            android:textColor="@color/neutral500"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFleetPlateNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            style="@style/Typography.Body2_SemiBold"
            tools:text="B 1234 EF"
            android:textColor="@color/neutral600"
            app:layout_constraintTop_toTopOf="@id/tvLabelPlateFleet"
            app:layout_constraintStart_toEndOf="@id/tvLabelPlateFleet"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Typography.Body2_SemiBold"
            android:text="@string/label_description"
            android:textColor="@color/neutral500"
            app:layout_constraintStart_toStartOf="@id/tvLabelPlateFleet"
            app:layout_constraintTop_toBottomOf="@id/tvLabelPlateFleet"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDODesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Typography.Body2_SemiBold"
            android:text="Activity Name Lorem Ipsum Dolor sit amet asdqweqwr"
            android:textColor="@color/neutral600"
            app:layout_constraintTop_toTopOf="@id/tvLabelDescription"
            app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
            app:layout_constraintEnd_toEndOf="parent"/>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelAssignedOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Typography.Body2_SemiBold"
            android:text="@string/label_time"
            android:textColor="@color/neutral500"
            app:layout_constraintTop_toBottomOf="@id/tvDODesc"
            app:layout_constraintStart_toStartOf="@id/tvLabelPlateFleet"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAssignedDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Typography.Body2_SemiBold"
            android:text="2022-10-20 14:00:00"
            android:textColor="@color/neutral600"
            app:layout_constraintTop_toTopOf="@id/tvLabelAssignedOn"
            app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAcceptTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ButtonPrimaryLighter"
            android:text="@string/button_accept_task"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@id/tvAssignedDate" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDuplicate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ButtonPrimaryLighter"
            android:text="@string/button_duplicate_task"
            android:layout_marginTop="11dp"
            android:visibility="gone"
            app:textAllCaps="true"
            app:layout_constraintTop_toBottomOf="@id/btnAcceptTask"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>