<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerHome"
    android:background="@color/primary50"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".driver.home.HomeFragment"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:menu="@menu/menu_drawer"
        app:headerLayout="@layout/layout_nav_header"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshHomeDriver"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarMenuHomeMechanic">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <com.automa.ui.custom_component.ToolbarMenu
                android:id="@+id/toolbarMenuHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary500"
                android:paddingHorizontal="16dp"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    style="@style/Typography.Subtitle1_SemiBold"
                    tools:text="Suparlan"
                    android:textColor="@color/white"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtUsername"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="8dp"
                        style="@style/TextInputEditText.White"
                        android:textColor="@color/primary500"
                        android:hint="@string/hint_search" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/llCurrentTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/primary500"
                        android:paddingBottom="24dp"
                        android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="16dp"
                            style="@style/Typography.Subtitle1_SemiBold"
                            android:text="@string/label_current_task"
                            android:textColor="@color/primary50"/>

                        <HorizontalScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <RadioGroup
                                android:id="@+id/rgCurrentTaskType"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="10dp"
                                android:layout_gravity="start"
                                android:orientation="horizontal">
                                <RadioButton
                                    android:id="@+id/rbTodayTask"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:minWidth="88dp"
                                    android:layout_marginStart="16dp"
                                    android:background="@drawable/selector_switch_home_light"
                                    android:checked="true"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:text="@string/label_today"
                                    android:fontFamily="@font/mulish_bold"
                                    android:textColor="@color/color_control_text_switch_home_light"
                                    android:textAppearance="@style/Typography.Body1_Bold"/>

                                <RadioButton
                                    android:id="@+id/rbAllTask"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="16dp"
                                    android:minWidth="88dp"
                                    android:background="@drawable/selector_switch_home_light"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:text="@string/label_all"
                                    android:fontFamily="@font/mulish_bold"
                                    android:textColor="@color/color_control_text_switch_home_light"
                                    android:textAppearance="@style/Typography.Body1_Bold"/>

                                <RadioButton
                                    android:id="@+id/rbMasterData"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:paddingHorizontal="8dp"
                                    android:layout_marginStart="16dp"
                                    android:minWidth="88dp"
                                    android:background="@drawable/selector_switch_home_light"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:text="@string/label_master_data"
                                    android:fontFamily="@font/mulish_bold"
                                    android:textColor="@color/color_control_text_switch_home_light"
                                    android:textAppearance="@style/Typography.Body1_Bold"/>

                                <RadioButton
                                    android:id="@+id/rbTaskHistory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:paddingHorizontal="8dp"
                                    android:layout_marginHorizontal="16dp"
                                    android:minWidth="88dp"
                                    android:background="@drawable/selector_switch_home_light"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:text="@string/label_task_history"
                                    android:fontFamily="@font/mulish_bold"
                                    android:textColor="@color/color_control_text_switch_home_light"
                                    android:textAppearance="@style/Typography.Body1_Bold"/>
                            </RadioGroup>
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/ll_category_master"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_category"
                                style="@style/Typography.Caption_Regular"
                                android:textColor="@color/primary50"/>
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                style="@style/TextInputLayout.Light"
                                app:endIconMode="custom"
                                app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
                                app:endIconTint="@color/neutral500">
                                <AutoCompleteTextView
                                    android:id="@+id/atvCategory"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="6dp"
                                    android:backgroundTint="@color/white"
                                    style="@style/TextInputEditText.White"
                                    android:textColor="@color/primary500"
                                    android:hint="@string/text_input_category"
                                    android:focusable="false"/>
                            </com.google.android.material.textfield.TextInputLayout>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/label_sub_category"
                                style="@style/Typography.Caption_Regular"
                                android:textColor="@color/primary50"/>
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSubCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                style="@style/TextInputLayout.Light"
                                app:endIconMode="custom"
                                app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
                                app:endIconTint="@color/neutral500">
                                <AutoCompleteTextView
                                    android:id="@+id/atvSubCategory"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="6dp"
                                    android:backgroundTint="@color/white"
                                    style="@style/TextInputEditText.White"
                                    android:textColor="@color/primary500"
                                    android:hint="@string/text_input_sub_category"
                                    android:focusable="false"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/progress_home_do"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:indeterminateTint="@color/white"
                            android:indeterminate="true"
                            android:paddingVertical="24dp"
                            android:visibility="gone"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_empty_do"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Typography.Body1_SemiBold"
                            android:text="@string/text_no_data"
                            android:textColor="@color/white"
                            android:paddingVertical="40dp"
                            android:gravity="center"
                            android:visibility="gone"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDeliveryOrder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:paddingHorizontal="16dp"
                            tools:listitem="@layout/item_do_task"
                            tools:itemCount="3"
                            app:layout_constraintTop_toTopOf="parent"
                            android:paddingBottom="40dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llFinishedTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="24dp"
                        android:orientation="vertical">
                        <RadioGroup
                            android:id="@+id/rgFinishedTaskType"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="16dp"
                            android:layout_gravity="start"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/rbFinishedTodayTask"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:minWidth="88dp"
                                android:background="@drawable/selector_switch_home_dark"
                                android:checked="true"
                                android:button="@null"
                                android:gravity="center"
                                android:text="@string/label_today"
                                android:fontFamily="@font/mulish_bold"
                                android:textColor="@color/color_control_text_switch_home_dark"
                                android:textAppearance="@style/Typography.Body1_Bold"/>

                            <RadioButton
                                android:id="@+id/rbFinishedAllTask"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="16dp"
                                android:minWidth="88dp"
                                android:background="@drawable/selector_switch_home_dark"
                                android:button="@null"
                                android:gravity="center"
                                android:text="@string/label_all"
                                android:fontFamily="@font/mulish_bold"
                                android:textColor="@color/color_control_text_switch_home_dark"
                                android:textAppearance="@style/Typography.Body1_Bold"/>
                        </RadioGroup>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            style="@style/Typography.Subtitle1_SemiBold"
                            android:text="@string/label_task_history"
                            android:textColor="@color/primary500"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvFinishedDeliveryOrder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            tools:listitem="@layout/item_do_task"
                            tools:itemCount="3"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.drawerlayout.widget.DrawerLayout>