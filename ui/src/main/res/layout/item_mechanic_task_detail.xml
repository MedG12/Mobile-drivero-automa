<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="4dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginVertical="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12.5dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Typography.Subtitle1_SemiBold"
            tools:text="DO.A.111.234.333"
            android:textColor="@color/primary500"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivEditSubTaskDetail"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_pencil_alt"
            app:layout_constraintTop_toTopOf="@id/tvSubTaskName"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:id="@+id/chipSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="76dp"
            android:minHeight="22dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/tvSubTaskName"
            app:layout_constraintBottom_toBottomOf="@id/tvSubTaskName"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_circle_check"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="@style/Typography.Caption_Regular"
                android:text="@string/label_task_progress_done"
                android:textColor="@color/success500"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubTaskName">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="@string/label_description"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Activity Name Lorem Ipsum Dolor sit amet asdqweqwr"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelDescription"
                app:layout_constraintStart_toEndOf="@id/tvLabelDescription"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Cost"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="@id/tvLabelDescription"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="50000"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelCost"
                app:layout_constraintStart_toStartOf="@id/tvDescription"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Duration"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvLabelCost"
                app:layout_constraintStart_toStartOf="@id/tvLabelCost"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Activity Name "
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelDuration"
                app:layout_constraintStart_toStartOf="@id/tvDescription"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFillDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/ButtonPrimaryLighter"
                android:text="ISI DETAIL"
                android:layout_marginTop="11dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>