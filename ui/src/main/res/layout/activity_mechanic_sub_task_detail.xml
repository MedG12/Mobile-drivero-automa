<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarMechanicSubTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="Sub Task Detail"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitleSubTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        tools:text="Test"
        app:layout_constraintTop_toBottomOf="@id/toolbarMechanicSubTaskDetail"/>
    <LinearLayout
        android:id="@+id/llAddTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="28dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tvTitleSubTaskDetail">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            app:srcCompat="@drawable/ic_plus"
            app:tint="@color/neutral500"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/Typography.Subtitle1_Regular"
            android:textColor="@color/neutral500"
            android:text="Add Task Detail"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMechanicTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        tools:listitem="@layout/item_mechanic_task_detail"
        app:layout_constraintTop_toBottomOf="@id/llAddTaskDetail"/>

</androidx.constraintlayout.widget.ConstraintLayout>