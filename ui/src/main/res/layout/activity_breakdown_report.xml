<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/clBreakdownReport"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarBreakdownReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="@string/button_breakdown_report"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/llInformationBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:background="@color/warning100"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbarBreakdownReport"
        app:layout_constraintBottom_toTopOf="@id/nsvBreakdownReport">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"
            style="@style/Typography.Subtitle2_Regular"
            android:text="@string/text_banner_breakdown_report"
            android:textColor="@color/warning700"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCloseBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/warning600"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvBreakdownReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/llInformationBanner"
        app:layout_constraintBottom_toTopOf="@id/llButtons">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="?attr/actionBarSize">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="16dp"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Typography.Subtitle1_SemiBold"
                    android:text="@string/button_breakdown_report"
                    android:textColor="@color/primary500"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_condition"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCondition"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:maxLines="1"
                        android:inputType="text"
                        android:textColor="@color/primary500"
                        android:hint="@string/text_input_condition" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_urgency"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUrgency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
                    app:endIconTint="@color/neutral500">
                    <AutoCompleteTextView
                        android:id="@+id/edtUrgency"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="@string/text_input_urgency"
                        android:focusable="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/title_fleet"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFleet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
                    app:endIconTint="@color/neutral500">
                    <AutoCompleteTextView
                        android:id="@+id/atvFleet"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="@string/text_input_fleet"
                        android:focusable="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_breakdown_desc"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:lines="4"
                        android:gravity="top"
                        android:textColor="@color/primary500"
                        android:hint="@string/text_input_desc_condition" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnAddCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"
                    app:srcCompat="@drawable/ic_add_category"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnAddSubCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_add_sub_category"/>
                <com.automa.ui.custom_component.tags.CustomTagContainer
                    android:id="@+id/customTagContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_sub_category"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSubCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
                    app:endIconTint="@color/neutral500">
                    <AutoCompleteTextView
                        android:id="@+id/atvSubCategory"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="@string/text_input_sub_category"
                        android:focusable="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.automa.ui.custom_component.check_box.CheckBoxItem
                    android:id="@+id/cbStoring"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"/>
                <LinearLayout
                    android:id="@+id/llStoringReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/label_storing_reason"
                        style="@style/Typography.Caption_Regular"
                        android:textColor="@color/neutral500"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStoringDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/TextInputLayout.Dark">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtStoringDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/primary500"
                            style="@style/TextInputEditText"
                            android:lines="2"
                            android:gravity="top"
                            android:textColor="@color/primary500"
                            android:hint="@string/text_input_desc_storing_reason" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="16dp"
                android:background="@color/white"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Typography.Subtitle1_SemiBold"
                    android:text="@string/label_fleet_condition_photo"
                    android:textColor="@color/primary500"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    style="@style/Typography.Caption_Regular"
                    android:text="@string/text_max_photo_breakdown_report"
                    android:textColor="@color/primary500"/>

                <include
                    android:id="@+id/layoutImage"
                    layout="@layout/custom_incident_image"/>

                <EditText
                    android:id="@+id/edtCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingBottom="16dp"
                    android:paddingHorizontal="12dp"
                    android:textAppearance="@style/Typography.Button_Regular"
                    android:backgroundTint="@color/primary500"
                    android:hint="@string/hint_incident_photo_caption"
                    android:fontFamily="@font/mulish_medium"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/ButtonWhiteBordered"
            android:text="@string/cancel"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:text="@string/button_submit"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>