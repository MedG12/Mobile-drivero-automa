<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarInputCertificateMechanic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="Sertifikat"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarInputCertificateMechanic"
        app:layout_constraintBottom_toTopOf="@id/llButtons">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="16dp"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Typography.Subtitle1_SemiBold"
                    android:text="Data Sertifikat"
                    android:textColor="@color/primary500"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nama Sertifikat"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCertName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCertName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:maxLines="1"
                        android:inputType="text"
                        android:textColor="@color/primary500"
                        android:hint="Masukkan nama sertifikat" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tanggal Sertifikat"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCertDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/edtCertDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="Pilih tanggal"
                        android:focusable="false"
                        android:cursorVisible="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tanggal Expiry"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExpDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/edtExpDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="Pilih tanggal"
                        android:focusable="false"
                        android:cursorVisible="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Level"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
                    app:endIconTint="@color/neutral500">
                    <AutoCompleteTextView
                        android:id="@+id/edtLevel"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="Pilih level"
                        android:focusable="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_description"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:gravity="top"
                        android:textColor="@color/primary500"
                        android:hint="Tulis deskripsi" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/ButtonWhiteBordered"
            android:text="@string/cancel"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:text="@string/button_submit"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>