<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:srcCompat="@drawable/ic_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvUploadTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="34dp"
        style="@style/Typography.Subtitle1_SemiBold"
        android:text="WO A.123123.1212 POD"
        android:textColor="@color/neutral500"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivClose"
        app:layout_constraintBottom_toBottomOf="@id/ivClose"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivImageResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivClose"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelUploadPhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/Typography.Subtitle1_SemiBold"
        android:textColor="@color/neutral500"
        android:text="@string/title_upload_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivImageResult"/>
    <LinearLayout
        android:id="@+id/llUploadPhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="100dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_border_dashed_neutral300"
        app:layout_constraintTop_toBottomOf="@id/tvLabelUploadPhoto">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:srcCompat="@drawable/ic_camera_icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            style="@style/Typography.Subtitle1_SemiBold"
            android:textColor="@color/neutral500"
            android:text="@string/message_pick_photo"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabelCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/Typography.Subtitle1_SemiBold"
        android:textColor="@color/neutral500"
        android:text="@string/title_photo_caption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llUploadPhoto"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/TextInputLayout.Dark"
        app:layout_constraintTop_toBottomOf="@id/tvLabelCaption">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCaption"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary500"
            style="@style/TextInputEditText"
            android:textColor="@color/primary500"
            android:hint="@string/hint_photo_caption" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tilCaption">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/ButtonWhiteBordered"
            android:text="@string/button_back"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:enabled="false"
            android:text="@string/button_upload"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>