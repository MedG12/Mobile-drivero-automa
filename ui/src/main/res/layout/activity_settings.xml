<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50"
    tools:context=".shared.setting.SettingsActivity">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarSetting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="Settings"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarSetting">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Bahasa"
            style="@style/Typography.Subtitle1_Regular"
            android:textColor="@color/neutral500"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/TextInputLayout.Dark"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:endIconTint="@color/neutral500">
            <AutoCompleteTextView
                android:id="@+id/edtLanguage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/primary500"
                style="@style/TextInputEditText"
                android:textColor="@color/primary500"
                android:hint="Pilih bahasa"
                android:focusable="false"/>
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelShowData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Perlihatkan Data"
            style="@style/Typography.Subtitle1_Regular"
            android:textColor="@color/neutral500"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilShowData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/TextInputLayout.Dark"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:endIconTint="@color/neutral500">
            <AutoCompleteTextView
                android:id="@+id/edtShowData"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/primary500"
                style="@style/TextInputEditText"
                android:textColor="@color/primary500"
                android:hint="Pilih"
                android:focusable="false"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:text="SIMPAN"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>