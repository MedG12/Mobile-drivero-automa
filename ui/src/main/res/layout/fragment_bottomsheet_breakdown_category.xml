<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp"
    android:clipToPadding="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitleCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Typography.Subtitle1_SemiBold"
        android:text="Pilih Kategori"
        android:textColor="@color/neutral500"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/TextInputLayout.Dark"
        android:visibility="gone"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_baseline_keyboard_arrow_down_24"
        app:endIconTint="@color/neutral500"
        app:layout_constraintTop_toBottomOf="@id/tvTitleCategory">
        <AutoCompleteTextView
            android:id="@+id/edtCategory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary500"
            style="@style/TextInputEditText"
            android:textColor="@color/primary500"
            android:hint="Pilih Kategori"
            android:focusable="false"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/mcvSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tilCategory">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextInputLayout.Dark">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                style="@style/TextInputEditText.White"
                android:textColor="@color/primary500"
                android:hint="@string/hint_search" />
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCheckBoxes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        tools:listitem="@layout/custom_check_sheet_item"
        app:layout_constraintTop_toBottomOf="@id/mcvSearch"
        app:layout_constraintBottom_toTopOf="@id/llButtons"/>
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/ButtonWhiteBordered"
            android:text="@string/cancel"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:text="@string/button_submit"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>