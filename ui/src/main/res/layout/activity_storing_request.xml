<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/clStoringRequest"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50"
    tools:context=".driver.storing.StoringRequestActivity">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarStoringRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="@string/title_storing_request"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/llInformationBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:background="@color/warning100"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbarStoringRequest"
        app:layout_constraintBottom_toTopOf="@id/nsvStoringRequest">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"
            style="@style/Typography.Subtitle2_Regular"
            android:text="@string/message_banner_fill_ticket"
            android:textColor="@color/warning700"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCloseBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/warning600"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvStoringRequest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/llInformationBanner"
        app:layout_constraintBottom_toTopOf="@id/llButtons">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@color/white">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Typography.Subtitle1_SemiBold"
                    android:text="@string/title_incident_ticket"
                    android:textColor="@color/primary500"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/Typography.Caption_Regular"
                    android:text="@string/label_ticket_number"
                    android:textColor="@color/primary500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTicketNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTicketNumber"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="@string/hint_ticket_number" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Typography.Caption_Regular"
                    android:text="@string/label_incident"
                    android:textColor="@color/primary500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilIncident"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtIncident"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:hint="@string/hint_incident" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Typography.Caption_Regular"
                    android:text="@string/label_current_odometer"
                    android:textColor="@color/primary500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOdometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark"
                    app:suffixText="km"
                    app:suffixTextColor="@color/primary500"
                    app:expandedHintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtOdometer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:textColor="@color/primary500"
                        android:inputType="numberDecimal"
                        android:hint="00" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Typography.Caption_Regular"
                    android:text="@string/label_location"
                    android:textColor="@color/primary500"/>
                <EditText
                    android:id="@+id/btnCurrentLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingBottom="16dp"
                    android:textAppearance="@style/Typography.Button_Regular"
                    android:drawableStart="@drawable/ic_current_location"
                    android:drawablePadding="4dp"
                    android:backgroundTint="@color/primary500"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false"
                    android:text="@string/label_use_current_location"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="16dp"
                android:background="@color/white"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Typography.Subtitle1_SemiBold"
                    android:text="@string/title_icident_photo"
                    android:textColor="@color/primary500"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    style="@style/Typography.Caption_Regular"
                    android:text="@string/message_max_photos"
                    android:textColor="@color/primary500"/>

                <include
                    android:id="@+id/layoutImage"
                    layout="@layout/custom_incident_image"/>

                <EditText
                    android:id="@+id/edtCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingBottom="16dp"
                    android:paddingHorizontal="12dp"
                    android:textAppearance="@style/Typography.Button_Regular"
                    android:backgroundTint="@color/primary500"
                    android:hint="@string/hint_incident_photo_caption"
                    android:fontFamily="@font/mulish_medium"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/ButtonWhiteBordered"
            android:text="@string/cancel"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:enabled="false"
            android:text="@string/button_submit"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>