<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="8dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/llCheckItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">
        <CheckBox
            android:id="@+id/cbCheckSheet"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/selector_checkbox"
            android:button="@null" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCheckBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            tools:text="Test"
            android:textColor="@color/neutral500"
            android:gravity="center_vertical"
            style="@style/Typography.Body2_Regular" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonReportCheckSheetItem"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            style="@style/ButtonPrimary"
            android:visibility="gone"
            android:text="LAPORKAN" />
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        style="@style/TextInputLayout.Dark"
        app:layout_constraintTop_toBottomOf="@id/llCheckItem">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary500"
            style="@style/TextInputEditText"
            android:lines="2"
            android:gravity="top"
            android:textColor="@color/primary500"
            android:hint="Tulis laporan" />
    </com.google.android.material.textfield.TextInputLayout>
</androidx.constraintlayout.widget.ConstraintLayout>