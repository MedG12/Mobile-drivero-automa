<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="?android:actionBarSize"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/primary500"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="16dp"
    android:paddingVertical="13dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivToolbarBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:srcCompat="@drawable/ic_arrow_left"
        app:tint="@color/primary50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Typography.Subtitle2_SemiBold"
        android:layout_marginStart="10dp"
        android:textColor="@color/primary50"
        tools:text="Lupa Password"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintEnd_toStartOf="@id/llIcons"
        app:layout_constraintTop_toTopOf="@id/ivToolbarBack"
        app:layout_constraintBottom_toBottomOf="@id/ivToolbarBack"
        app:layout_constraintStart_toEndOf="@id/ivToolbarBack"/>
    <LinearLayout
        android:id="@+id/llIcons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivToolbarBack"
        app:layout_constraintBottom_toBottomOf="@id/ivToolbarBack"/>
</androidx.constraintlayout.widget.ConstraintLayout>