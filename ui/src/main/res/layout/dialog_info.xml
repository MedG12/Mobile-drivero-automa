<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:orientation="vertical">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDialog"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="72dp"
        app:srcCompat="@drawable/illustration_success_forgot_password"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitleDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        style="@style/Typography.Body1_SemiBold"
        android:gravity="center"
        tools:text="Sedang Menunggu"
        android:textColor="@color/neutral500"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessageDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        style="@style/Typography.Body2_Regular"
        android:gravity="center"
        tools:text="Data masih diproses untuk approval"
        android:textColor="@color/neutral500"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNegative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            tools:text="BATAL"
            android:visibility="gone"
            style="@style/ButtonWhiteBordered"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="KEMBALI KE BERANDA"
            app:textAllCaps="true"
            style="@style/ButtonPrimaryLighter"/>
    </LinearLayout>
</LinearLayout>