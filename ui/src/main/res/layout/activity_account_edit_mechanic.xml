<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral50">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="@string/title_edit_account"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarAccount"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clHeaderEditAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@color/white">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_user_default"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivEditPhoto"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:srcCompat="@drawable/ic_camera_button"
                    android:layout_marginEnd="-8dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/ivPhoto"
                    app:layout_constraintEnd_toEndOf="@id/ivPhoto"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Typography.Body2_SemiBold"
                    tools:text="Suparlan"
                    android:textColor="@color/neutral800"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivPhoto"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="2dp"
                    style="@style/Typography.Body2_SemiBold"
                    tools:text="+ 62 811 124 4578"
                    android:gravity="center"
                    android:textColor="@color/neutral800"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvUsername"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivDob"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_user"
                        app:tint="@color/primary500"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLabelDob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        style="@style/Typography.Overline_Regular"
                        android:text="@string/label_dob"
                        android:textColor="@color/neutral400"
                        app:layout_constraintStart_toEndOf="@id/ivDob"
                        app:layout_constraintTop_toTopOf="@id/ivDob"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Typography.Caption_Bold"
                        tools:text="10-05-1980"
                        android:textColor="@color/neutral500"
                        app:layout_constraintStart_toStartOf="@id/tvLabelDob"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelDob"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLabelIdNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/Typography.Overline_Regular"
                        android:text="@string/label_id_number"
                        android:textColor="@color/neutral400"
                        app:layout_constraintStart_toStartOf="@id/tvLabelDob"
                        app:layout_constraintTop_toBottomOf="@id/tvDob"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvIdNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Typography.Caption_Bold"
                        tools:text="3255 48878 24577 6555"
                        android:textColor="@color/neutral500"
                        app:layout_constraintStart_toStartOf="@id/tvLabelDob"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelIdNumber"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditDob"
                        android:layout_width="70dp"
                        android:layout_height="32dp"
                        style="@style/ButtonWhiteBordered"
                        android:text="@string/button_edit_account"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivLicense"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_credit_card"
                        app:tint="@color/primary500"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLabelLicenseType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        style="@style/Typography.Overline_Regular"
                        android:text="@string/label_licens_type"
                        android:textColor="@color/neutral400"
                        app:layout_constraintStart_toEndOf="@id/ivLicense"
                        app:layout_constraintTop_toTopOf="@id/ivLicense"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLicenseType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Typography.Caption_Bold"
                        tools:text="SIM B1"
                        android:textColor="@color/neutral500"
                        app:layout_constraintStart_toStartOf="@id/tvLabelLicenseType"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelLicenseType"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLabelLicenseNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/Typography.Overline_Regular"
                        android:text="@string/label_license_number"
                        android:textColor="@color/neutral400"
                        app:layout_constraintStart_toStartOf="@id/tvLabelLicenseType"
                        app:layout_constraintTop_toBottomOf="@id/tvLicenseType"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLicenseNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        style="@style/Typography.Caption_Bold"
                        tools:text="7213T289"
                        android:textColor="@color/neutral500"
                        app:layout_constraintStart_toStartOf="@id/tvLabelLicenseType"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelLicenseNumber"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditLicense"
                        android:layout_width="70dp"
                        android:layout_height="32dp"
                        style="@style/ButtonWhiteBordered"
                        android:text="@string/button_edit_account"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCertification"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_document"
                        app:tint="@color/primary500"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLabelCertification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        style="@style/Typography.Overline_Regular"
                        android:text="CERTIFICATE"
                        android:textColor="@color/neutral400"
                        app:layout_constraintStart_toEndOf="@id/ivCertification"
                        app:layout_constraintTop_toTopOf="@id/ivCertification"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCertification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Typography.Caption_Bold"
                        tools:text="10-05-1980"
                        android:textColor="@color/neutral500"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="@id/tvLabelCertification"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelCertification"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditCertificate"
                        android:layout_width="70dp"
                        android:layout_height="32dp"
                        style="@style/ButtonWhiteBordered"
                        android:text="@string/button_view_account"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCertificateListMechanic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_certificate_list_mechanic"
                        tools:itemCount="3"
                        app:layout_constraintTop_toBottomOf="@id/ivCertification"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_logo_automa_mechanic" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>