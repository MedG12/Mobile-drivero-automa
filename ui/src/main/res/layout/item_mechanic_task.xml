<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="4dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginVertical="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12.5dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMaintenanceNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Typography.Subtitle1_SemiBold"
            tools:text="DO.A.111.234.333"
            android:textColor="@color/primary500"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="13dp"
            android:background="@drawable/bg_chip_status"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvMaintenanceNumber"
            app:layout_constraintStart_toStartOf="@id/tvMaintenanceNumber">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                style="@style/Typography.Caption_Regular"
                android:text="@string/label_task_progress_done"
                android:textColor="@color/neutral500"/>
        </LinearLayout>
        <!--    <androidx.appcompat.widget.AppCompatTextView-->
        <!--        android:id="@+id/tvViewTask"-->
        <!--        android:layout_width="wrap_content"-->
        <!--        android:layout_height="wrap_content"-->
        <!--        android:text="@string/label_view"-->
        <!--        android:textColor="@color/primary500"-->
        <!--        style="@style/Typography.Subtitle2_Regular"-->
        <!--        app:layout_constraintEnd_toEndOf="parent"-->
        <!--        app:layout_constraintTop_toTopOf="@id/tvDONumber"-->
        <!--        app:layout_constraintBottom_toBottomOf="@id/tvDONumber"/>-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@id/chipStatus">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="@string/label_description"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Activity Name Lorem Ipsum Dolor sit amet asdqweqwr"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelDescription"
                app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelPlateFleet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="@string/label_fleet_plate"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="@id/tvLabelDescription"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFleetPlateNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                style="@style/Typography.Body2_SemiBold"
                tools:text="B 1234 EF"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelPlateFleet"
                app:layout_constraintStart_toEndOf="@id/tvLabelPlateFleet"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelWorkshop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Workshop"
                android:textColor="@color/neutral500"
                app:layout_constraintStart_toStartOf="@id/tvLabelPlateFleet"
                app:layout_constraintTop_toBottomOf="@id/tvFleetPlateNumber"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWorkshop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Workshop Name"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelWorkshop"
                app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
                app:layout_constraintEnd_toEndOf="parent"/>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelAssignedOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="@string/label_time"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvLabelWorkshop"
                app:layout_constraintStart_toStartOf="@id/tvLabelPlateFleet"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAssignedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="2022-10-20 14:00:00"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelAssignedOn"
                app:layout_constraintStart_toStartOf="@id/tvFleetPlateNumber"
                app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFillDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/ButtonPrimaryLighter"
                        android:text="ISI DETAIL"
                        android:layout_marginTop="11dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/tvAssignedDate"
                        app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>