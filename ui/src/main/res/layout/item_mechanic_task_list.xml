<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="4dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginVertical="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12.5dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMaintenanceNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Typography.Subtitle1_SemiBold"
            tools:text="DO.A.111.234.333"
            android:textColor="@color/primary500"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:id="@+id/chipSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="76dp"
            android:minHeight="22dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/tvMaintenanceNumber"
            app:layout_constraintBottom_toBottomOf="@id/tvMaintenanceNumber"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_circle_check"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="@style/Typography.Caption_Regular"
                android:text="@string/label_task_progress_done"
                android:textColor="@color/success500"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@id/tvMaintenanceNumber">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelMechanicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Mekanik"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMechanicName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Mekanik One"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelMechanicName"
                app:layout_constraintStart_toEndOf="@id/tvLabelMechanicName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="@string/label_description"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvMechanicName"
                app:layout_constraintStart_toStartOf="@id/tvLabelMechanicName" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Activity Name Lorem Ipsum Dolor sit amet asdqweqwr"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelDescription"
                app:layout_constraintStart_toStartOf="@id/tvMechanicName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelPlateFleet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Plat Fleet"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="@id/tvLabelMechanicName" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPlateFleet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="B 1234 F"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelPlateFleet"
                app:layout_constraintStart_toStartOf="@id/tvMechanicName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelWorkshop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Workshop"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvLabelPlateFleet"
                app:layout_constraintStart_toStartOf="@id/tvLabelMechanicName" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWorkshop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="Workshop 1"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelWorkshop"
                app:layout_constraintStart_toStartOf="@id/tvMechanicName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelScheduledTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Waktu"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvWorkshop"
                app:layout_constraintStart_toStartOf="@id/tvLabelMechanicName" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScheduledTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="2022-10-20 14:00"
                android:textColor="@color/neutral600"
                app:layout_constraintTop_toTopOf="@id/tvLabelScheduledTime"
                app:layout_constraintStart_toStartOf="@id/tvMechanicName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Typography.Body2_SemiBold"
                android:text="Durasi"
                android:textColor="@color/neutral500"
                app:layout_constraintTop_toBottomOf="@id/tvScheduledTime"
                app:layout_constraintStart_toStartOf="@id/tvLabelMechanicName" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Typography.Body2_SemiBold"
                android:text="0 Menit"
                android:textColor="@color/neutral200"
                app:layout_constraintTop_toTopOf="@id/tvLabelDuration"
                app:layout_constraintStart_toStartOf="@id/tvMechanicName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvDuration"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUploadProof"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonPrimaryLighter"
                    android:text="LIHAT / TAMBAHKAN BUKTI"
                    android:layout_marginTop="11dp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddMechanic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonWhiteBordered"
                    android:text="TAMBAH MEKANIK"
                    android:layout_marginTop="11dp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFillDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonPrimaryLighter"
                    android:text="ISI DETAIL"
                    android:layout_marginTop="11dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>