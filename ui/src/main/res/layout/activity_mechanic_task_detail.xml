<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50"
    tools:context=".mechanic.task.MechanicTaskActivity">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarMechanicTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="Task Detail"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitleTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        tools:text="Test"
        app:layout_constraintTop_toBottomOf="@id/toolbarMechanicTaskDetail"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMechanicTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        tools:listitem="@layout/item_mechanic_task_list"
        app:layout_constraintTop_toBottomOf="@id/tvTitleTaskDetail"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>