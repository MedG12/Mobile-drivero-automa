<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/clBreakdownReport"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary50">
    <com.automa.ui.custom_component.ToolbarBasic
        android:id="@+id/toolbarInputSubTaskDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:toolbarText="Input Task Detail"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvBreakdownReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarInputSubTaskDetail"
        app:layout_constraintBottom_toTopOf="@id/llButtons">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="?attr/actionBarSize">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="16dp"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTaskName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Typography.Subtitle1_SemiBold"
                    android:text="Laporan"
                    android:textColor="@color/primary500"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nama"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:maxLines="1"
                        android:inputType="text"
                        android:textColor="@color/primary500"
                        android:hint="Masukkan Nama" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Deskripsi"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:lines="4"
                        android:gravity="top"
                        android:textColor="@color/primary500"
                        android:hint="Tuliskan kondisi fleet saat ini" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Cost"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:prefixText="Rp"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCost"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:maxLines="1"
                        android:inputType="number"
                        android:textColor="@color/primary500"
                        android:hint="Cost" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Durasi Maintenance"
                    style="@style/Typography.Caption_Regular"
                    android:textColor="@color/neutral500"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:suffixText="Menit"
                    style="@style/TextInputLayout.Dark">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDuration"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/primary500"
                        style="@style/TextInputEditText"
                        android:maxLines="1"
                        android:inputType="number"
                        android:textColor="@color/primary500"
                        android:hint="Durasi" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/ButtonWhiteBordered"
            android:text="@string/cancel"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/ButtonPrimary"
            android:text="@string/button_submit"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>